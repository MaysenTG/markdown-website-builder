# URL of the Cloudflare Worker that proxies OpenAI. Leave empty to keep AI editing off.
# Local `npx wrangler dev` default: http://127.0.0.1:8787
VITE_AI_PROXY_URL=

# Optional. Must match the Worker's GATE_TOKEN secret.
# This value is embedded in the static JavaScript bundle, so treat it as a speed bump,
# not a secret. See the README.
VITE_AI_GATE_TOKEN=
